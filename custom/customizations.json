{
  "schema_version": 2,
  "source": {
    "repository": "frostmage1250/mihomo-script",
    "branch": "main",
    "path": "mihomoScript.js"
  },
  "rule_source": {
    "repository": "frostmage1250/proxy-rules-converter",
    "branch": "egern",
    "directory": "rules",
    "update_interval": 86400
  },
  "routing": {
    "apns": {
      "provider": "apns",
      "policy": "代理",
      "after_provider": "mcdn屏蔽",
      "no_resolve": true
    },
    "privaterelay": {
      "provider": "privaterelay",
      "policy": "代理",
      "after_provider": "microsoft"
    },
    "omit_foreign_quic": true,
    "mcdn": {
      "provider": "mcdn屏蔽",
      "before_provider": "geolocation-cn"
    }
  },
  "real_ip_domains": [
    "lancache.steamcontent.com",
    "*.msftconnecttest.com",
    "*.msftncsi.com",
    "*.srv.nintendo.net",
    "*.stun.playstation.net",
    "xbox.*.microsoft.com",
    "*.xboxlive.com",
    "*.logon.battlenet.com.cn",
    "*.logon.battle.net",
    "stun.l.google.com",
    "easy-login.10099.com.cn",
    "*-update.xoyocdn.com",
    "*.prod.cloud.netflix.com",
    "appboot.netflix.com",
    "*-appboot.netflix.com",
    "apt-agent.com",
    "*.apt-agent.com"
  ],
  "groups": {
    "filter_append": {
      "低倍率节点": "实验"
    },
    "extra_subscriptions": [
      "订阅2",
      "订阅3"
    ],
    "remove_candidates": [
      "IPv4优先",
      "IPv6优先"
    ],
    "prepend": {
      "代理": [
        "订阅",
        "订阅2"
      ]
    },
    "append": {
      "Google": [
        "订阅"
      ],
      "Telegram": [
        "香港",
        "订阅",
        "订阅2"
      ],
      "PikPak": [
        "香港"
      ],
      "EHentai": [
        "美国",
        "新加坡",
        "低倍率节点"
      ],
      "AI": [
        "订阅",
        "订阅3"
      ],
      "Claude": [
        "订阅3"
      ]
    },
    "replace": {
      "porn": [
        "香港",
        "新加坡",
        "美国",
        "低倍率节点"
      ]
    },
    "flatten": {
      "代理": false
    },
    "aliases": {
      "手动选择": "订阅",
      "默认代理": "代理"
    },
    "remove": [
      "Direct",
      "直连"
    ]
  },
  "dns": {
    "hosts_override": {
      "11612bj3-b76c.aws-agent.biz": "06996bj6-79x5.apt-agent.com",
      "b76c5sh0-fde6.aws-agent.biz": "08233sh6-12d1.apt-agent.com",
      "fde63gz6-1y61.aws-agent.biz": "09571gz6-86k1.apt-agent.com"
    },
    "direct_domain_system_dns": true,
    "system_dns_providers": [
      "cn"
    ],
    "hosts_exclude_suffixes": [
      "mcdn.bilivideo.com",
      "mcdn.bilivideo.cn",
      "edge.mountaintoys.cn",
      "h2.smtcdns.net"
    ],
    "private_dns": {
      "Doro": {
        "servers": [
          "https://dns.nianyun.net/dns-query/nyi0d8t-7fujtwi9iao0cem15pwxn101"
        ],
        "domains": [
          "akile-hinet-ads4323.645781.xyz",
          "ali.dorocloud.xyz",
          "aws.dorocloud.xyz",
          "awsjp.ixiplc.com",
          "ecs22.ycsh.shop",
          "gcp.dorocloud.xyz",
          "hkt.mao2.de",
          "tengxun.dorocloud.xyz"
        ]
      },
      "MESL": {
        "servers": [
          "https://zone.rlose.com:39933/api-query",
          "https://radar.rlose.com/api-query"
        ],
        "domain_suffixes": [
          "911-gt2-rs.com"
        ]
      },
      "Flower": {
        "servers": [
          "tls://119.29.29.29",
          "tls://223.5.5.5",
          "https://dns.pub/dns-query",
          "https://dns.alidns.com/dns-query"
        ],
        "domain_suffixes": [
          "aws-agent.biz",
          "apt-agent.com"
        ]
      }
    }
  },
  "profile": {
    "ipv6": true,
    "vif_only": true,
    "block_quic": false,
    "close_connections_on_policy_change": true,
    "include_all_networks": true,
    "include_apns": true,
    "default_subscription_group": "订阅",
    "default_proxy_group": "代理"
  },
  "services": {
    "exclude": [
      "Line",
      "Netflix",
      "Emby",
      "Spotify",
      "Crypto",
      "PayPal",
      "Patreon",
      "FCM"
    ]
  },
  "icons": {
    "enabled": false
  },
  "latency_tests": {
    "enabled": false
  }
}
