{
  "schema_version": 2,
  "source": {
    "repository": "frostmage1250/mihomo-script",
    "branch": "main",
    "path": "mihomoScript.js"
  },
  "rule_source": {
    "repository": "frostmage1250/proxy-rules-converter",
    "branch": "egern",
    "directory": "rules",
    "update_interval": 86400
  },
  "routing": {
    "apns": {
      "provider": "apns",
      "policy": "默认代理",
      "after_provider": "mcdn屏蔽",
      "no_resolve": true
    },
    "privaterelay": {
      "provider": "privaterelay",
      "policy": "默认代理",
      "after_provider": "microsoft"
    }
  }
}
