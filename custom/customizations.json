{
  "schema_version": 2,
  "source": {
    "repository": "frostmage1250/mihomo-script",
    "branch": "main",
    "path": "mihomoScript.js"
  },
  "rule_source": {
    "repository": "frostmage1250/proxy-rules-converter",
    "branch": "egern",
    "directory": "rules",
    "update_interval": 86400
  },
  "routing": {
    "apns": {
      "provider": "apns",
      "policy": "默认代理",
      "after_provider": "mcdn屏蔽",
      "no_resolve": true
    },
    "privaterelay": {
      "provider": "privaterelay",
      "policy": "默认代理",
      "after_provider": "microsoft"
    }
  },
  "real_ip_domains": [
    "lancache.steamcontent.com",
    "*.msftconnecttest.com",
    "*.msftncsi.com",
    "*.srv.nintendo.net",
    "*.stun.playstation.net",
    "xbox.*.microsoft.com",
    "*.xboxlive.com",
    "*.logon.battlenet.com.cn",
    "*.logon.battle.net",
    "stun.l.google.com",
    "easy-login.10099.com.cn",
    "*-update.xoyocdn.com",
    "*.prod.cloud.netflix.com",
    "appboot.netflix.com",
    "*-appboot.netflix.com"
  ],
  "groups": {
    "filter_append": {
      "低倍率节点": "实验"
    },
    "extra_subscriptions": [
      "订阅2"
    ],
    "remove_candidates": [
      "IPv4优先",
      "IPv6优先"
    ],
    "prepend": {
      "默认代理": [
        "手动选择",
        "订阅2"
      ]
    },
    "append": {
      "Google": [
        "手动选择"
      ],
      "Telegram": [
        "香港",
        "手动选择",
        "订阅2"
      ],
      "媒体": [
        "香港",
        "手动选择",
        "订阅2",
        "美国",
        "日本"
      ],
      "PikPak": [
        "香港"
      ],
      "EHentai": [
        "美国",
        "新加坡",
        "低倍率节点"
      ],
      "AI": [
        "手动选择"
      ]
    },
    "replace": {
      "porn": [
        "香港",
        "新加坡",
        "美国",
        "低倍率节点"
      ]
    },
    "flatten": {
      "默认代理": false
    },
    "extra_groups": [
      {
        "name": "媒体",
        "after": "Google",
        "policies": [
          "默认代理",
          "低倍率节点",
          "香港",
          "美国",
          "手动选择",
          "订阅2",
          "日本"
        ]
      }
    ]
  },
  "dns": {
    "proxy_nameservers": [
      "https://zone.rlose.com:39933/api-query",
      "https://radar.rlose.com/api-query"
    ],
    "hosts_override": {
      "11612bj3-b76c.aws-agent.biz": "06996bj6-79x5.apt-agent.com",
      "b76c5sh0-fde6.aws-agent.biz": "08233sh6-12d1.apt-agent.com",
      "fde63gz6-1y61.aws-agent.biz": "09571gz6-86k1.apt-agent.com"
    }
  }
}
