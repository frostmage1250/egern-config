{
  "schema_version": 2,
  "source": {
    "repository": "frostmage1250/mihomo-script",
    "branch": "main",
    "path": "mihomoScript.js"
  },
  "rule_source": {
    "repository": "frostmage1250/proxy-rules-converter",
    "branch": "egern",
    "directory": "rules",
    "update_interval": 86400
  },
  "routing": {
    "apns": {
      "provider": "apns",
      "policy": "默认代理",
      "after_provider": "mcdn屏蔽",
      "no_resolve": true
    },
    "privaterelay": {
      "provider": "privaterelay",
      "policy": "默认代理",
      "after_provider": "microsoft"
    }
  },
  "real_ip_domains": [
    "lancache.steamcontent.com",
    "*.msftconnecttest.com",
    "*.msftncsi.com",
    "*.srv.nintendo.net",
    "*.stun.playstation.net",
    "xbox.*.microsoft.com",
    "*.xboxlive.com",
    "*.logon.battlenet.com.cn",
    "*.logon.battle.net",
    "stun.l.google.com",
    "easy-login.10099.com.cn",
    "*-update.xoyocdn.com",
    "*.prod.cloud.netflix.com",
    "appboot.netflix.com",
    "*-appboot.netflix.com"
  ],
  "groups": {
    "filter_append": {
      "低倍率节点": "实验"
    },
    "extra_subscriptions": [
      "订阅2"
    ]
  },
  "dns": {
    "proxy_nameservers": [
      "https://zone.rlose.com:39933/api-query",
      "https://radar.rlose.com/api-query"
    ],
    "hosts_override": {
      "11612bj3-b76c.aws-agent.biz": "06996bj6-79x5.apt-agent.com",
      "b76c5sh0-fde6.aws-agent.biz": "08233sh6-12d1.apt-agent.com",
      "fde63gz6-1y61.aws-agent.biz": "09571gz6-86k1.apt-agent.com"
    }
  }
}
